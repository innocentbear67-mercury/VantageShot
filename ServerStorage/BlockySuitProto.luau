	-- helmet (original design: rounded block, wide wraparound visor, brow ridge, side vents)
	add(P("Head", 0, 1.64, 0.02, 1.32, 1.3, 1.32, "Plate", 0.2)) -- shell
	add(P("Head", 0, 2.3, 0.04, 0.42, 0.14, 1.06, "Plate", 0.05)) -- crest
	add(A("Head", { { -0.6, 2.0 }, { 0.6, 2.0 }, { 0.54, 1.5 }, { 0.2, 1.38 }, { -0.2, 1.38 }, { -0.54, 1.5 } }, -0.64, 0.1, "Trim", 0.04)) -- visor frame
	add(A("Head", { { -0.52, 1.94 }, { 0.52, 1.94 }, { 0.46, 1.56 }, { 0.16, 1.46 }, { -0.16, 1.46 }, { -0.46, 1.56 } }, -0.69, 0.06, "Visor", 0.03, Enum.Material.Neon)) -- visor
	add(A("Head", { { -0.62, 2.12 }, { 0.62, 2.12 }, { 0.6, 2.02 }, { 0, 1.96 }, { -0.6, 2.02 } }, -0.64, 0.16, "Plate", 0.04)) -- brow
	add(A("Head", { { -0.4, 1.36 }, { 0.4, 1.36 }, { 0.3, 1.12 }, { -0.3, 1.12 } }, -0.62, 0.18, "Trim", 0.05)) -- jaw guard
	for _, s in { -1, 1 } do
		add(P("Head", s * 0.7, 1.62, 0.06, 0.12, 0.5, 0.6, "Trim", 0.04)) -- ear pod
		add(P("Head", s * 0.77, 1.62, 0.06, 0.04, 0.22, 0.3, "Accent", 0.01)) -- ear light strip
	end
	return t
end

function Proto.Rig(): Model
	local rig = Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	rig.Name = "BlockyOperative"
	-- the game's character uses classic Motor6D joints (animations, viewmodel, intro clips write
	-- Motor6D transforms): swap the default AnimationConstraint joints for Motor6Ds at the same places
	for _, d in rig:GetDescendants() do
		if d:IsA("AnimationConstraint") and d.Attachment0 and d.Attachment1 then
			local a0, a1 = d.Attachment0, d.Attachment1
			local m = Instance.new("Motor6D")
			m.Name = d.Name
			m.Part0, m.Part1 = a0.Parent :: BasePart, a1.Parent :: BasePart
			m.C0, m.C1 = a0.CFrame, a1.CFrame
			m.Parent = a1.Parent
			d:Destroy()
		elseif d:IsA("BallSocketConstraint") then
			d:Destroy()
		end
	end
	return rig
end

function Proto.Dress(rig: Model, palette)
	palette = palette or Proto.Palettes.Slate
	local root = rig:FindFirstChild("HumanoidRootPart") :: BasePart
	local rootCF = root.CFrame
	local folder = Instance.new("Folder")
	folder.Name = "Suit"
	for _, d in rig:GetDescendants() do
		if d:IsA("Decal") then d.Transparency = 1 end
		if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") then d:Destroy() end
	end
	for _, p in rig:GetChildren() do
		if p:IsA("BasePart") and p ~= root then p.Transparency = 1 end
	end
	for i, s in spec() do
		local body = rig:FindFirstChild(s.Part) :: BasePart?
		if body then
			local mp = (if s.Poly then polyMesh(s.Poly, s.Depth, s.Ch) else chamferMesh(s.Size, s.Ch)):Clone()
			mp.Name = s.Part .. "_" .. i
			mp.Anchored = false
			mp.Massless = true
			mp.CanCollide, mp.CanQuery, mp.CanTouch = false, false, false
			mp.Material = s.Mat or Enum.Material.SmoothPlastic
			mp.Color = palette[s.Col] or palette.Plate
			mp.CastShadow = s.Mat ~= Enum.Material.Neon
			mp:SetAttribute("SuitSlot", s.Col)
			mp.CFrame = rootCF * CFrame.new(s.Pos)
			local w = Instance.new("WeldConstraint")
			w.Part0, w.Part1 = body, mp
			w.Parent = mp
			mp.Parent = folder
		end
	end
	folder.Parent = rig
	return folder
end

return Proto
