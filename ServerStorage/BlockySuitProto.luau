--[[
	BlockySuitProto (2026-11-14) — prototype of the blocky Vantage suit.
	Classic blocky R15 proportions (torso 2x2x1, one-block arms and legs): a grey undersuit shell on every
	body part, chamfered armour plates on top, dark trim, glowing visor. Plates are chamfered boxes made
	with EditableMesh at build time (a prototype shortcut: final suits get Blender meshes, uploaded).
	Every piece is welded to its body part, so the suit moves rigidly with the limb it sits on: nothing
	crosses a joint.
	API  Proto.Rig() -> blocky R15 rig (Roblox default body)
	     Proto.Dress(rig, palette?) -> Folder of pieces (body parts hidden)
	     Proto.Palettes  { Slate, Ivory, Ember }
]]
local AssetService = game:GetService("AssetService")
local Players = game:GetService("Players")

local C = Color3.fromRGB
local V = Vector3.new
local Proto = {}

Proto.Palettes = {
	Slate = { Plate = C(72, 98, 136), Under = C(84, 88, 96), Trim = C(34, 37, 43), Visor = C(90, 200, 255), Accent = C(170, 230, 80) },
	Ivory = { Plate = C(176, 172, 162), Under = C(74, 78, 86), Trim = C(32, 34, 39), Visor = C(120, 230, 60), Accent = C(150, 235, 60) },
	Ember = { Plate = C(132, 58, 42), Under = C(72, 74, 80), Trim = C(30, 30, 34), Visor = C(255, 170, 60), Accent = C(255, 170, 60) },
}

-- chamfered box: every edge cut at 45 degrees (6 inset faces, 12 bevel strips, 8 corner triangles), flat shaded
local cache = {}
local function chamferMesh(s: Vector3, c: number)
	local key = string.format("%.3f_%.3f_%.3f_%.3f", s.X, s.Y, s.Z, c)
	if cache[key] then return cache[key] end
	local hx, hy, hz = s.X / 2, s.Y / 2, s.Z / 2
	c = math.min(c, hx * 0.45, hy * 0.45, hz * 0.45)
	local em = AssetService:CreateEditableMesh()
	-- every face is convex and the solid is centred on the origin: a face points outward when its normal
	-- agrees with its centroid, so winding is fixed here instead of trusted from the caller
	local function quad(a, b, cc, d)
		local n = (b - a):Cross(cc - a)
		if n.Magnitude < 1e-6 then return end
		if n:Dot((a + b + cc + d) / 4) < 0 then a, b, cc, d = d, cc, b, a; n = -n end
		n = n.Unit
		local ia, ib, ic, id = em:AddVertex(a), em:AddVertex(b), em:AddVertex(cc), em:AddVertex(d)
		local ni = nil
		pcall(function() ni = em:AddNormal(n) end)
		local f1 = em:AddTriangle(ia, ib, ic)
		local f2 = em:AddTriangle(ia, ic, id)
		if ni then pcall(function() em:SetFaceNormals(f1, { ni, ni, ni }); em:SetFaceNormals(f2, { ni, ni, ni }) end) end
	end
	local function tri(a, b, cc)
		local n = (b - a):Cross(cc - a)
		if n.Magnitude < 1e-6 then return end
		if n:Dot((a + b + cc) / 3) < 0 then b, cc = cc, b; n = -n end
		local ia, ib, ic = em:AddVertex(a), em:AddVertex(b), em:AddVertex(cc)
		local f = em:AddTriangle(ia, ib, ic)
		pcall(function() local ni = em:AddNormal(n.Unit); em:SetFaceNormals(f, { ni, ni, ni }) end)
	end
	local X, Y, Z = hx, hy, hz
	local x, y, z = hx - c, hy - c, hz - c
	-- main faces (counter-clockwise seen from outside)
	quad(V(X, -y, -z), V(X, y, -z), V(X, y, z), V(X, -y, z)) -- +X
	quad(V(-X, -y, z), V(-X, y, z), V(-X, y, -z), V(-X, -y, -z)) -- -X
	quad(V(-x, Y, -z), V(-x, Y, z), V(x, Y, z), V(x, Y, -z)) -- +Y
	quad(V(-x, -Y, z), V(-x, -Y, -z), V(x, -Y, -z), V(x, -Y, z)) -- -Y
	quad(V(-x, -y, Z), V(x, -y, Z), V(x, y, Z), V(-x, y, Z)) -- +Z
	quad(V(x, -y, -Z), V(-x, -y, -Z), V(-x, y, -Z), V(x, y, -Z)) -- -Z
	-- bevel strips and corners, generated by sign
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			-- edge along Z between X and Y faces
			local a, b = V(sx * X, sy * y, -z), V(sx * x, sy * Y, -z)
			local cc, d = V(sx * x, sy * Y, z), V(sx * X, sy * y, z)
			if sx * sy > 0 then quad(a, b, cc, d) else quad(d, cc, b, a) end
		end
		for _, sz in { -1, 1 } do
			-- edge along Y between X and Z faces
			local a, b = V(sx * X, -y, sz * z), V(sx * x, -y, sz * Z)
			local cc, d = V(sx * x, y, sz * Z), V(sx * X, y, sz * z)
			if sx * sz > 0 then quad(d, cc, b, a) else quad(a, b, cc, d) end
		end
	end
	for _, sy in { -1, 1 } do
		for _, sz in { -1, 1 } do
			-- edge along X between Y and Z faces
			local a, b = V(-x, sy * Y, sz * z), V(-x, sy * y, sz * Z)
			local cc, d = V(x, sy * y, sz * Z), V(x, sy * Y, sz * z)
			if sy * sz > 0 then quad(d, cc, b, a) else quad(a, b, cc, d) end
		end
	end
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			for _, sz in { -1, 1 } do
				local a, b, cc = V(sx * X, sy * y, sz * z), V(sx * x, sy * Y, sz * z), V(sx * x, sy * y, sz * Z)
				if sx * sy * sz > 0 then tri(a, b, cc) else tri(a, cc, b) end
			end
		end
	end
	local mp = AssetService:CreateMeshPartAsync(Content.fromObject(em))
	cache[key] = mp
	return mp
end

-- angled plate: a convex outline (front view, XY, centred on the origin) extruded along Z with a bevel on
-- both faces. Gives the cut corners and V shapes of the reference without a modelling round trip.
local function polyMesh(pts, depth: number, c: number)
	local key = depth .. "_" .. c
	for _, p in pts do key ..= string.format("_%.3f,%.3f", p.X, p.Y) end
	if cache[key] then return cache[key] end
	local n = #pts
	local ctr = Vector2.zero
	for _, p in pts do ctr += p end
	ctr /= n
	-- inset outline: each edge moved inward by c, neighbours intersected
	local function inward(a, b)
		local e = (b - a).Unit
		local nrm = Vector2.new(-e.Y, e.X)
		if nrm:Dot(ctr - a) < 0 then nrm = -nrm end
		return nrm
	end
	local inset = {}
	for i = 1, n do
		local p0, p1, p2 = pts[(i - 2) % n + 1], pts[i], pts[i % n + 1]
		local n1, n2 = inward(p0, p1), inward(p1, p2)
		local a1, d1 = p0 + n1 * c, (p1 - p0).Unit
		local a2, d2 = p1 + n2 * c, (p2 - p1).Unit
		local den = d1.X * d2.Y - d1.Y * d2.X
		if math.abs(den) < 1e-6 then
			inset[i] = p1 + n1 * c
		else
			local t = ((a2.X - a1.X) * d2.Y - (a2.Y - a1.Y) * d2.X) / den
			inset[i] = a1 + d1 * t
		end
	end
	local em = AssetService:CreateEditableMesh()
	local function face(list)
		-- convex face: fan from its centroid; winding fixed outward (the solid is centred on the origin)
		local m = Vector3.zero
		for _, v in list do m += v end
		m /= #list
		for i = 1, #list do
			local a, b = list[i], list[i % #list + 1]
			local nn = (a - m):Cross(b - m)
			if nn.Magnitude > 1e-7 then
				if nn:Dot((a + b + m) / 3) < 0 then a, b = b, a; nn = -nn end
				local ia, ib, im = em:AddVertex(m), em:AddVertex(a), em:AddVertex(b)
				local f = em:AddTriangle(ia, ib, im)
				pcall(function() local ni = em:AddNormal(nn.Unit); em:SetFaceNormals(f, { ni, ni, ni }) end)
			end
		end
	end
	local h = depth / 2
	local front, back = {}, {}
	for i = 1, n do
		local q = inset[i] - ctr
		front[i], back[i] = V(q.X, q.Y, -h), V(q.X, q.Y, h)
	end
	face(front)
	face(back)
	for i = 1, n do
		local j = i % n + 1
		local o1, o2 = pts[i] - ctr, pts[j] - ctr
		local i1, i2 = inset[i] - ctr, inset[j] - ctr
		face({ V(o1.X, o1.Y, -h + c), V(o2.X, o2.Y, -h + c), V(o2.X, o2.Y, h - c), V(o1.X, o1.Y, h - c) }) -- side
		face({ V(o1.X, o1.Y, -h + c), V(i1.X, i1.Y, -h), V(i2.X, i2.Y, -h), V(o2.X, o2.Y, -h + c) }) -- front bevel
		face({ V(o1.X, o1.Y, h - c), V(o2.X, o2.Y, h - c), V(i2.X, i2.Y, h), V(i1.X, i1.Y, h) }) -- back bevel
	end
	local mp = AssetService:CreateMeshPartAsync(Content.fromObject(em))
	cache[key] = mp
	return mp, ctr
end

-- one piece: size, centre (rest pose, relative to the root), chamfer, colour key, body part it rides on
local function P(part, cx, cy, cz, sx, sy, sz, col, ch, mat)
	return { Part = part, Pos = V(cx, cy, cz), Size = V(sx, sy, sz), Col = col, Ch = ch or 0.06, Mat = mat }
end
-- angled plate: outline in rest-pose XY (absolute), depth along Z centred at cz; s = -1 mirrors it
local function A(part, pts, cz, depth, col, ch, mat, s)
	local list = {}
	for _, p in pts do table.insert(list, Vector2.new(p[1] * (s or 1), p[2])) end
	local ctr = Vector2.zero
	for _, p in list do ctr += p end
	ctr /= #list
	return { Part = part, Poly = list, Pos = V(ctr.X, ctr.Y, cz), Depth = depth, Col = col, Ch = ch or 0.05, Mat = mat }
end

local function spec()
	local t = {}
	local function add(p) table.insert(t, p) end
	-- torso
	add(P("UpperTorso", 0, 0.22, 0, 2.04, 1.66, 1.04, "Under", 0.08))
	add(P("LowerTorso", 0, -0.76, 0, 2.02, 0.5, 1.02, "Under", 0.06))
	for _, s in { -1, 1 } do
		-- chest plates meet in a V over the sternum; outer lower corner cut
		add(A("UpperTorso", { { 0.06, 0.98 }, { 0.9, 0.98 }, { 0.9, 0.42 }, { 0.5, 0.06 }, { 0.06, 0.2 } }, -0.56, 0.18, "Plate", 0.05, nil, s))
		add(A("UpperTorso", { { 0.62, 0.3 }, { 0.92, 0.3 }, { 0.92, -0.2 }, { 0.62, -0.2 }, { 0.5, -0.02 } }, -0.54, 0.12, "Plate", 0.04, nil, s)) -- rib plate
		add(P("UpperTorso", s * 0.94, 0.5, 0, 0.16, 0.9, 0.86, "Plate", 0.06)) -- side plates
	end
	add(A("UpperTorso", { { -0.4, 0.02 }, { 0.4, 0.02 }, { 0.3, -0.36 }, { -0.3, -0.36 } }, -0.55, 0.14, "Plate", 0.04)) -- abdomen plate
	add(A("UpperTorso", { { -0.1, 0.16 }, { 0.1, 0.16 }, { 0, 0.05 } }, -0.6, 0.06, "Accent", 0.01, Enum.Material.Neon)) -- core light
	add(P("UpperTorso", 0, 1.08, -0.02, 1.36, 0.2, 0.94, "Trim", 0.06)) -- collar
	add(P("UpperTorso", 0, 0.5, 0.58, 1.66, 1.1, 0.16, "Plate", 0.08)) -- back plate
	add(P("UpperTorso", 0, 0.42, 0.78, 1.16, 0.86, 0.3, "Trim", 0.08)) -- pack
	add(P("UpperTorso", 0, 0.42, 0.94, 0.7, 0.12, 0.04, "Visor", 0.02, Enum.Material.Neon)) -- pack light
	add(P("LowerTorso", 0, -0.62, 0, 2.1, 0.22, 1.1, "Trim", 0.05)) -- belt
	add(P("LowerTorso", 0, -0.62, -0.57, 0.42, 0.2, 0.06, "Plate", 0.03)) -- buckle
	for _, s in { -1, 1 } do
		add(P("LowerTorso", s * 0.62, -0.63, -0.58, 0.28, 0.26, 0.14, "Plate", 0.04)) -- pouches
	end
	-- arms
	for _, s in { -1, 1 } do
		local ua, la, h = (s < 0 and "LeftUpperArm" or "RightUpperArm"), (s < 0 and "LeftLowerArm" or "RightLowerArm"), (s < 0 and "LeftHand" or "RightHand")
		local x = s * 1.5
		add(P(ua, x, 0.37, 0, 1.02, 1.24, 1.02, "Under", 0.06))
		add(A(ua, { { 0.94, 1.06 }, { 2.04, 1.06 }, { 2.1, 0.94 }, { 2.1, 0.6 }, { 1.84, 0.36 }, { 0.94, 0.36 } }, 0, 1.18, "Plate", 0.08, nil, s)) -- shoulder pad
		add(P(ua, x + s * 0.1, 0.78, -0.6, 0.56, 0.05, 0.03, "Trim", 0.01)) -- pad panel line
		add(P(ua, x + s * 0.03, 0.33, 0, 1.1, 0.1, 1.1, "Trim", 0.03)) -- pad lip
		add(P(la, x, -0.22, 0, 1.02, 1.1, 1.02, "Under", 0.06))
		add(A(la, { { 0.94, 0.04 }, { 2.06, 0.04 }, { 2.06, -0.48 }, { 1.88, -0.66 }, { 0.94, -0.66 } }, 0, 1.14, "Plate", 0.07, nil, s)) -- gauntlet
		add(P(la, x, -0.3, -0.57, 0.5, 0.08, 0.04, "Accent", 0.02)) -- gauntlet slot
		add(P(h, x, -0.85, 0, 1.04, 0.34, 1.06, "Trim", 0.06)) -- glove
	end
	-- legs
	for _, s in { -1, 1 } do
		local ul, ll, f = (s < 0 and "LeftUpperLeg" or "RightUpperLeg"), (s < 0 and "LeftLowerLeg" or "RightLowerLeg"), (s < 0 and "LeftFoot" or "RightFoot")
		local x = s * 0.5
		add(P(ul, x, -1.42, 0, 1.0, 1.36, 0.98, "Under", 0.06))
		add(A(ul, { { -0.04, -0.86 }, { 1.04, -0.86 }, { 1.04, -1.4 }, { 0.86, -1.58 }, { 0.14, -1.58 }, { -0.04, -1.4 } }, -0.02, 1.06, "Plate", 0.07, nil, s)) -- thigh plate
		add(P(ll, x, -2.2, 0, 1.0, 1.3, 0.98, "Under", 0.06))
		add(A(ll, { { 0.3, -1.62 }, { 0.7, -1.62 }, { 0.84, -1.8 }, { 0.7, -2.04 }, { 0.3, -2.04 }, { 0.16, -1.8 } }, -0.56, 0.18, "Plate", 0.05, nil, s)) -- knee pad
		add(A(ll, { { -0.04, -2.12 }, { 0.2, -2.0 }, { 0.8, -2.0 }, { 1.04, -2.12 }, { 1.04, -2.76 }, { -0.04, -2.76 } }, -0.02, 1.06, "Plate", 0.07, nil, s)) -- shin guard
