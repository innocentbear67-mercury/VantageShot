		add(P(f, x, -2.85, -0.05, 1.06, 0.32, 1.14, "Trim", 0.06)) -- boot
		add(P(f, x, -2.78, -0.62, 0.7, 0.06, 0.04, "Accent", 0.02)) -- toe stripe
