--[[
	VANTAGE — EnsureCoreRemotes (server): a fresh rojo build has no Vantage.Remotes folder (the
	live place's is saved inside the place file, and nothing in this repo created it). Create
	every core remote here at boot through the shared RemotesLib — find-or-create, so the live
	place is untouched — and never depend on instances saved in a place file. Consumers
	WaitForChild, so boot order never matters.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RemotesLib = require(ReplicatedStorage.Vantage.RemotesLib)

-- client-invoked (OnServerInvoke / InvokeServer)
RemotesLib.get("MatchRequest", "RemoteFunction")
RemotesLib.get("ChooseTeam", "RemoteFunction")
RemotesLib.get("SettingsGet", "RemoteFunction")
RemotesLib.get("ProgressionGet", "RemoteFunction")
RemotesLib.get("MasteryGet", "RemoteFunction")
