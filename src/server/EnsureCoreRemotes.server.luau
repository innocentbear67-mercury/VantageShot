RemotesLib.get("IchorCrate", "RemoteFunction")
RemotesLib.get("CrateOpen", "RemoteFunction")
RemotesLib.get("CrateBuy", "RemoteFunction")
RemotesLib.get("PassClaim", "RemoteFunction")

